rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      let path = /databases/$(database)/documents/system_users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : null;
    }

    // Owner: nageshn444@gmail.com OR 20726@pyidcc.bmrcl.com
    // Use the authenticated UID too so Google sign-in works reliably even if the email claim is missing.
    function isOwner() {
      return isSignedIn() && (
        request.auth.uid == 'EByfpLYSWsM2nxTKB1urzXgHjV02' ||
        request.auth.token.email == 'nageshn444@gmail.com' ||
        request.auth.token.email == '20726@pyidcc.bmrcl.com' ||
        getUserRole() == 'SUPER_ADMIN'
      );
    }

    function isAdmin() {
      let role = getUserRole();
      return isOwner() ||
             role == 'ADMIN_Station_Superintendent' ||
             role == 'ADMIN_SS' ||
             role == 'ADMIN' ||
             role == 'ALS' ||
             role == 'GCC' ||
             role == 'co ordinators' ||
             role == 'COORDINATOR';
    }

    function isAdminOrController() {
      return isAdmin() || (isSignedIn() && getUserRole() == 'CREW_CONTROLLER');
    }

    function isBmrclStaff() {
      return isSignedIn() && (
        isAdminOrController() ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@bmrc\\.co\\.in$') ||
          request.auth.token.email.matches('.*@pyidcc\\.bmrcl\\.com$')
        ))
      );
    }

    function isUserSelf(employeeId) {
      let path = /databases/$(database)/documents/system_users/$(request.auth.uid);
      return exists(path) && string(get(path).data.employeeId) == string(employeeId);
    }

    // ═══════════════════════════════════════════════════════════════
    //  OWNER GLOBAL OVERRIDE  (write anywhere)
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow write: if isOwner();
      allow read:  if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════
    //  AUTHENTICATION & REGISTRATION FLOW
    //  Supports both signInWithRedirect (Google) and Employee ID flows
    // ═══════════════════════════════════════════════════════════════

    // New Google users can create their own system_users doc on first login
    // Existing users can read their own doc; admins can read all
    match /system_users/{userId} {
      // Allow unauthenticated LIST only for login employeeId lookup (pre-auth Firestore-first check)
      allow list:   if true;
      allow get:    if isSignedIn() && (request.auth.uid == userId || isAdminOrController());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdminOrController() || isOwner());
      allow update: if isAdminOrController() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.status  == resource.data.status &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdminOrController() && userId != 'EByfpLYSWsM2nxTKB1urzXgHjV02';
    }

    // Login requests: unauthenticated users can create (Google redirect pending users)
    match /login_requests/{requestId} {
      allow get:            if true;
      allow list:           if isAdminOrController();
      allow create:         if true;          // unauthenticated new users after redirect
      allow update, delete: if isAdminOrController();
    }

    // Legacy login requests collection
    match /loginRequests/{requestId} {
      allow read:           if isAdminOrController();
      allow create:         if true;          // unauthenticated new users
      allow update, delete: if isAdminOrController();
    }

    // Registration requests (older flow)
    match /registrationRequests/{requestId} {
      allow read:   if isOwner() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if true;
      allow update, delete: if isOwner() || getUserRole() == 'ADMIN';
    }

    // ═══════════════════════════════════════════════════════════════
    //  AUDIT & HISTORY LOGGING
    // ═══════════════════════════════════════════════════════════════

    match /login_history/{documentId} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();    // must be auth'd to write
      allow update, delete: if false;
    }

    match /loginHistory/{logId} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  USER & PERMISSION MANAGEMENT
    // ═══════════════════════════════════════════════════════════════

    match /users/{employeeId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && (
        request.auth.token.email == string(employeeId) + '@pyidcc.bmrcl.com' ||
        isUserSelf(employeeId)
      ));
      allow update: if (isAdmin() || (isSignedIn() && (
          request.auth.token.email == string(employeeId) + '@pyidcc.bmrcl.com' ||
          isUserSelf(employeeId)
        ) && (
          request.resource.data.role   == resource.data.role &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.status == resource.data.status
        )
      )) && (
        employeeId != '20726' || (
          request.resource.data.role   == 'SUPER_ADMIN' &&
          request.resource.data.active == true &&
          request.resource.data.status == 'ACTIVE'
        )
      );
      allow delete: if isAdmin() && employeeId != '20726';
    }

    match /userPermissions/{employeeId} {
      allow read:   if isSignedIn();
      // Admins AND Crew Controllers can set per-operator permission overrides
      allow create: if isAdminOrController() || (isSignedIn() && request.auth.token.email == string(employeeId) + '@pyidcc.bmrcl.com');
      allow update: if isAdminOrController() && employeeId != '20726';
      allow delete: if isAdminOrController() && employeeId != '20726';
    }


    match /userAccessControl/{employeeId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && (
        request.auth.token.email == string(employeeId) + '@pyidcc.bmrcl.com' ||
        isUserSelf(employeeId)
      ));
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.token.email == string(employeeId) + '@pyidcc.bmrcl.com' ||
          isUserSelf(employeeId)
        ) &&
        request.resource.data.canLogin         == resource.data.canLogin &&
        request.resource.data.canAccessWebApp  == resource.data.canAccessWebApp &&
        request.resource.data.canAccessMobileApp == resource.data.canAccessMobileApp &&
        request.resource.data.deviceStatus     == resource.data.deviceStatus
      );
      allow delete: if isAdmin() && employeeId != '20726';
    }

    match /role_permissions/{roleId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read:  if isSignedIn();
      allow write: if isOwner();
    }

    // ═══════════════════════════════════════════════════════════════
    //  CORE OPERATIONAL MODULES
    // ═══════════════════════════════════════════════════════════════

    match /wtt_final_matrix/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /daily_crew_tracks/{documentId} {
      allow read:          if isBmrclStaff();
      allow write, update: if isAdminOrController();
    }

    match /working_time_table/{tripId} {
      allow read:  if isBmrclStaff();
      allow write: if isAdminOrController();
    }

    match /manual_overrides/{documentId} {
      allow read:                  if isBmrclStaff();
      allow create, update, delete: if isAdminOrController();
    }

    match /employees/{documentId} {
      allow read:                  if isSignedIn();
      allow create, update, delete: if isAdminOrController();
    }

    match /crew_final_links/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /crew_daily_deployment/{documentId} {
      allow read:  if isSignedIn();
      // Admins/controllers: full write (create, update, delete)
      allow delete: if isAdminOrController();
      // Any authenticated user can create or update a deployment doc
      // (empId ownership is enforced in the frontend; backend requires auth at minimum)
      allow create, update: if isSignedIn();
    }

    match /crew_live_attendance/{documentId} {
      allow read:  if isSignedIn();
      // Admins/controllers can write anything
      allow write: if isAdminOrController();
      // Any authenticated operator can write their own attendance
      allow create, update: if isSignedIn();
    }

    match /wtt_live_incidents/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /automated_dispatch_gate/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    // ═══════════════════════════════════════════════════════════════
    //  EQUIPMENT & FLEET
    // ═══════════════════════════════════════════════════════════════

    match /rake_registry/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /rolling_stock_faults/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    // ═══════════════════════════════════════════════════════════════
    //  SAFETY & TRAINING
    // ═══════════════════════════════════════════════════════════════

    match /safety_incidents/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /staff_training/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /training_sessions/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /daily_safety_checklists/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    match /competency_records/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    // ═══════════════════════════════════════════════════════════════
    //  LEAVE, SHIFTS & CREW MODULES
    // ═══════════════════════════════════════════════════════════════

    match /leave_requests/{documentId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdminOrController();
    }

    match /weekly_off_planner/{documentId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdminOrController();
    }

    match /extra_duty_roster/{documentId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdminOrController();
    }

    match /manual_review_roster/{documentId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdminOrController();
    }

    match /shift_exchanges/{documentId} {
      allow read:           if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete:         if isAdminOrController();
    }

    match /shift_handover_notes/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    match /asset_transactions/{documentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrController();
    }

    match /crewRegistry/{documentId} {
      allow get:    if true;
      allow list:   if isSignedIn();
      allow create: if isAdminOrController();
      allow update: if isAdminOrController() || (
        isSignedIn() && isUserSelf(documentId) &&
        (!('employeeId'      in resource.data) || request.resource.data.employeeId      == resource.data.employeeId)      &&
        (!('employeeName'    in resource.data) || request.resource.data.employeeName    == resource.data.employeeName)    &&
        (!('designation'     in resource.data) || request.resource.data.designation     == resource.data.designation)     &&
        (!('role'            in resource.data) || request.resource.data.role            == resource.data.role)            &&
        (!('depot'           in resource.data) || request.resource.data.depot           == resource.data.depot)           &&
        (!('department'      in resource.data) || request.resource.data.department      == resource.data.department)      &&
        (!('doj'             in resource.data) || request.resource.data.doj             == resource.data.doj)             &&
        (!('retirementDate'  in resource.data) || request.resource.data.retirementDate  == resource.data.retirementDate)  &&
        (!('bloodGroup'      in resource.data) || request.resource.data.bloodGroup      == resource.data.bloodGroup)      &&
        (!('operationalCrew' in resource.data) || request.resource.data.operationalCrew == resource.data.operationalCrew) &&
        (!('active'          in resource.data) || request.resource.data.active          == resource.data.active)          &&
        (!('deleted'         in resource.data) || request.resource.data.deleted         == resource.data.deleted)
      );
      allow delete: if isAdminOrController();
    }
  }
}